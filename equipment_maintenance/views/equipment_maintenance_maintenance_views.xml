<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View equipment.maintenance.maintenance View List -->
    <record id="view_equipment_maintenance_maintenance_list" model="ir.ui.view">
        <field name="name">view.equipment.maintenance.maintenance.list</field>
        <field name="model">equipment.maintenance.maintenance</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'"
                  decoration-info="state == 'in_progress'"
                  decoration-muted="state == 'draft'"
                  decoration-danger="state == 'cancelled'">
                <field name="sequence"/>
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="created_by"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="planned_hours" sum="Planned Hours"/>
                <field name="hours" sum="Executed Hours"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- View equipment.maintenance.maintenance Kanban -->
    <record id="view_equipment_maintenance_maintenance_kanban" model="ir.ui.view">
        <field name="name">view.equipment.maintenance.maintenance.kanban</field>
        <field name="model">equipment.maintenance.maintenance</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state"
                    class="o_kanban_small_column o_equipment_maintenance_maintenance_kanban"
                    sample="1">
                <field name="task_count"/>
                <field name="state"/>
                <progressbar field="state"
                             colors='{"draft": "secondary", "in_progress": "info", "done": "success", "cancelled": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <main t-att-class="'o_equipment_maintenance_task_card o_task_state_' + record.state.raw_value + (['done', 'cancelled'].includes(record.state.raw_value) ? ' opacity-50' : '')">
                            <div class="d-flex justify-content-between align-items-start">
                                <span class="text-muted o_kanban_record_subtitle">
                                    <field name="sequence"/>
                                </span>
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'draft': 'secondary', 'in_progress': 'info', 'done': 'success', 'cancelled': 'danger'}}"/>
                            </div>
                            <field name="name" class="fw-bold fs-5"/>
                            <div class="text-muted d-flex flex-column">
                                <field name="equipment_id" options="{'no_open': True}"/>
                                <field name="created_by" options="{'no_open': True}"/>
                            </div>
                            <footer class="pt-2">
                                <div class="d-flex align-items-center">
                                    <a class="o_equipment_maintenance_kanban_box" name="action_view_tasks" type="object">
                                        <span class="fa fa-tasks me-1" title="Tasks"/>
                                        <field name="task_count"/> Tasks
                                    </a>
                                </div>
                                <div class="d-flex ms-auto align-items-center">
                                    <span class="fa fa-clock-o me-1" title="Executed Hours"/>
                                    <field name="hours"/>
                                    <span class="ms-1">h</span>
                                </div>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- View equipment.maintenance.maintenance form -->
    <record id="view_equipment_maintenance_maintenance_form" model="ir.ui.view">
        <field name="name">view.equipment.maintenance.maintenance.form</field>
        <field name="model">equipment.maintenance.maintenance</field>
        <field name="arch" type="xml">
            <form string="Equipment Maintenance Maintenance">
                <header>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancelled')"
                            confirm="This will cancel all tasks of this maintenance. Are you sure?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="equipment_id"/>
                            <field name="created_by"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="planned_hours"/>
                            <field name="hours"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids"
                                context="{
                                    'form_view_ref': 'equipment_maintenance.view_equipment_maintenance_task_form',
                                }"
                            >
                                <list>
                                    <field name="name"/>
                                    <field name="date_task"/>
                                    <field name="responsible_id"/>
                                    <field name="hours" sum="Total Hours"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'"
                                           decoration-info="state == 'in_progress'"
                                           decoration-warning="state == 'draft'"
                                           decoration-danger="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Description..."/>
                        </page>
                        <page string="Responsible" name="responsible">
                            <field name="responsible_ids" widget="many2many_tags" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View equipment.maintenance.maintenance search -->
    <record id="view_equipment_maintenance_maintenance_search" model="ir.ui.view">
        <field name="name">view.equipment.maintenance.maintenance.search</field>
        <field name="model">equipment.maintenance.maintenance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sequence"/>
                <field name="equipment_id"/>
                <field name="created_by"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                    <filter string="Equipment" name="equipment_id" domain="[]" context="{'group_by':'equipment_id'}"/>
                    <filter string="Created By" name="created_by" domain="[]" context="{'group_by':'created_by'}"/>
                    <filter string="Status" name="status" domain="[]" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action equipment.maintenance.maintenance -->
    <record id="action_equipment_maintenance_maintenance" model="ir.actions.act_window">
        <field name="name">Equipment Maintenance Maintenance</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">equipment.maintenance.maintenance</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Equipment Maintenance Maintenance.
            </p>
        </field>
    </record>

</odoo>
