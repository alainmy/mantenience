<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View equipment.maintenance.maintenance View List -->
    <record id="view_equipment_maintenance_maintenance_list" model="ir.ui.view">
        <field name="name">view.equipment.maintenance.maintenance.list</field>
        <field name="model">equipment.maintenance.maintenance</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="created_by"/>
                <field name="hours" sum="Total Hours"/>
            </list>
        </field>
    </record>

    <!-- View equipment.maintenance.maintenance form -->
    <record id="view_equipment_maintenance_maintenance_form" model="ir.ui.view">
        <field name="name">view.equipment.maintenance.maintenance.form</field>
        <field name="model">equipment.maintenance.maintenance</field>
        <field name="arch" type="xml">
            <form string="Equipment Maintenance Maintenance">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="equipment_id"/>
                        </group>
                        <group>
                            <field name="created_by"/>
                            <field name="hours"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="date_task"/>
                                    <field name="responsible_id"/>
                                    <field name="hours" sum="Total Hours"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'"
                                           decoration-info="state == 'in_progress'"
                                           decoration-warning="state == 'draft'"
                                           decoration-danger="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Description..."/>
                        </page>
                        <page string="Responsible" name="responsible">
                            <field name="responsible_ids" widget="many2many_tags" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View equipment.maintenance.maintenance search -->
    <record id="view_equipment_maintenance_maintenance_search" model="ir.ui.view">
        <field name="name">view.equipment.maintenance.maintenance.search</field>
        <field name="model">equipment.maintenance.maintenance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sequence"/>
                <field name="equipment_id"/>
                <field name="created_by"/>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                    <filter string="Equipment" name="equipment_id" domain="[]" context="{'group_by':'equipment_id'}"/>
                    <filter string="Created By" name="created_by" domain="[]" context="{'group_by':'created_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action equipment.maintenance.maintenance -->
    <record id="action_equipment_maintenance_maintenance" model="ir.actions.act_window">
        <field name="name">Equipment Maintenance Maintenance</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">equipment.maintenance.maintenance</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Equipment Maintenance Maintenance.
            </p>
        </field>
    </record>

</odoo>
