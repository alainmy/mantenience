<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View equipment.maintenance.task View List -->
    <record id="view_equipment_maintenance_task_list" model="ir.ui.view">
        <field name="name">view.equipment.maintenance.task.list</field>
        <field name="model">equipment.maintenance.task</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'"
                  decoration-info="state == 'in_progress'"
                  decoration-warning="state == 'draft'"
                  decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="maintenance_id"/>
                <field name="equipment_id"/>
                <field name="date_task"/>
                <field name="responsible_id"/>
                <field name="hours" sum="Total Hours"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- View equipment.maintenance.task form -->
    <record id="view_equipment_maintenance_task_form" model="ir.ui.view">
        <field name="name">view.equipment.maintenance.task.form</field>
        <field name="model">equipment.maintenance.task</field>
        <field name="arch" type="xml">
            <form string="Equipment Maintenance Task">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="maintenance_id"/>
                            <field name="equipment_id" readonly="1"/>
                            <field name="date_task"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="created_by" readonly="1"/>
                            <field name="hours"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Description..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View equipment.maintenance.task search -->
    <record id="view_equipment_maintenance_task_search" model="ir.ui.view">
        <field name="name">view.equipment.maintenance.task.search</field>
        <field name="model">equipment.maintenance.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="maintenance_id"/>
                <field name="equipment_id"/>
                <field name="responsible_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="My Tasks" name="my_tasks" domain="[('responsible_id', '=', uid)]"/>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                    <filter string="Maintenance" name="maintenance_id" domain="[]" context="{'group_by':'maintenance_id'}"/>
                    <filter string="Equipment" name="equipment_id" domain="[]" context="{'group_by':'equipment_id'}"/>
                    <filter string="Responsible" name="responsible_id" domain="[]" context="{'group_by':'responsible_id'}"/>
                    <filter string="Status" name="state" domain="[]" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action equipment.maintenance.task -->
    <record id="action_equipment_maintenance_task" model="ir.actions.act_window">
        <field name="name">Equipment Maintenance Task</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">equipment.maintenance.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Equipment Maintenance Task.
            </p>
        </field>
    </record>

</odoo>
